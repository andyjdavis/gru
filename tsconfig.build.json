{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": "./src",
        "noEmit": false,
        "importHelpers": true,
        "noEmitHelpers": false,
        "module": "esnext",
        "moduleResolution": "bundler",
        "skipLibCheck": true
    },
    "exclude": [
        "dist",
        "**/*test.ts",
        "**/fixtures/*"
    ]
}